{
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(grep:*)",
      "Bash(pwd)",
      "Bash(pwd:*)",
      "Bash(base64:*)",
      "Bash(rm -f pr:*)",
      "Bash(date:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Read",
      "Grep",
      "Glob",
      "WebFetch",
      "Write(state/**)",
      "Task"
    ],
    "deny": [
      "Bash(gh pr diff*)",
      "Bash(gh api *pulls/*/files*)",
      "Bash(gh api *tarball*)",
      "Bash(gh api *zipball*)",
      "Bash(gh api *vnd.github*.diff*)",
      "Bash(gh api *vnd.github*.patch*)",
      "Bash(gh repo clone*)",
      "Bash(git clone*)"
    ]
  }
}
