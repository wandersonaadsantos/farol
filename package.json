{
  "name": "farol",
  "productName": "Farol",
  "version": "2.78.17",
  "description": "Radar de Pull Requests: monitora o GitHub e revisa com Claude Code ou Codex CLI.",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "author": "Wanderson Santos",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "check": "node tools/check-syntax.js",
    "lint": "node tools/quality/gate.js && node tools/quality/higiene.js",
    "lint:update": "node tools/quality/gate.js --update",
    "eng": "node tools/eng-behaviour/gate.js",
    "sync:rules": "node tools/sync-rules.js",
    "test": "node tools/rodar-testes.js",
    "hooks:install": "git config core.hooksPath tools/hooks",
    "prestart": "node lib/node-runtime.js",
    "preserver": "node lib/node-runtime.js",
    "pretest": "node lib/node-runtime.js",
    "precheck": "node lib/node-runtime.js",
    "prelint": "node lib/node-runtime.js",
    "preeng": "node lib/node-runtime.js"
  },
  "dependencies": {
    "electron": "^44.9.3"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5"
  }
}
