#!/bin/sh
# Gate de pré-push do Farol (29/08/2026).
#
# POR QUE EXISTE: o CI roda DEPOIS do push, e a `main` aceita push direto (o
# Repository admin tem bypass do ruleset). Ou seja, entre "empurrei" e "descobri
# que quebrou" havia uma janela em que a `main` já estava vermelha. Este hook
# fecha a janela do lado que dá pra fechar localmente: nada sobe com o gate local
# vermelho.
#
# O QUE ELE NÃO FAZ, e é importante não confundir: ele NÃO substitui o CI. Parte
# da suíte pula fora do POSIX (o instalador do macOS, o spawn headless posix, o
# killTree por grupo de processo, o chmod da credencial), e isso depende do
# SISTEMA, não do shell: Git Bash no Windows não recupera nenhum deles. Quem
# cobre as três plataformas é a matriz do .github/workflows/ci.yml, e continua
# sendo. Aqui o contrato é mais modesto e honesto: o que roda nesta máquina tem
# que estar verde antes de sair dela.
#
# Escape hatch: `git push --no-verify`. É do git, não precisa de opção nossa.
# Use quando souber por que está pulando (ex.: subir um branch de trabalho pra
# disparar o CI da matriz justamente porque o local não cobre aquilo).
#
# Instalação: `npm run hooks:install` (grava core.hooksPath nesta pasta). O
# core.hooksPath é config LOCAL do clone, então cada clone instala uma vez.

set -e

echo ""
echo "  Farol · gate de pre-push"
echo ""

falhou() {
  echo ""
  echo "  BLOQUEADO: $1 reprovou. Corrija, ou use 'git push --no-verify' se souber por que esta pulando."
  echo ""
  exit 1
}

# --- push direto na main: PROIBIDO (decisao do Wanderson, 29/08/2026) ----------
# O ruleset "main protegida" exige pull request e o check `ci`, e o Repository
# admin tem bypass. Ate hoje TODO push da main passou por cima da propria regra:
# o proprio git responde "Bypassed rule violations for refs/heads/main".
#
# A regra virou: NUNCA usar o bypass. E ela nao pode depender de disciplina, que
# e a doutrina do repo (ver "Travas automaticas" no CLAUDE.md). Entao o gate
# recusa aqui, antes de o bypass ser exercido.
#
# Custa pouco porque o ruleset pede ZERO aprovacoes: o fluxo e branch -> PR ->
# CI verde -> merge, sem depender de ninguem. E de quebra a matriz
# Linux/Windows/macOS passa a rodar ANTES da main, que era a outra metade que
# faltava (o CI roda em pull_request desde sempre).
#
# git manda por stdin: <ref local> <sha local> <ref remota> <sha remota>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -n "$remote_ref" ] || continue
  case "$remote_ref" in
    refs/heads/main)
      echo "  BLOQUEADO: push direto na main usa o bypass de admin, e isso nao se faz mais aqui."
      echo ""
      echo "  O caminho e:"
      echo "    git switch -c <branch> && git push origin <branch>"
      echo "    gh pr create --fill"
      echo "    (CI verde nos tres SOs) && gh pr merge --merge --delete-branch"
      echo ""
      echo "  O ruleset pede ZERO aprovacoes, entao voce mesmo fecha o PR."
      echo "  Emergencia real: 'git push --no-verify', e registre o porque."
      echo ""
      exit 1
      ;;
  esac
done

# Hooks recebem `GIT_DIR`, `GIT_WORK_TREE` e outras variáveis locais do processo
# que chamou o push. Elas são corretas enquanto o hook inspeciona o push acima,
# mas não podem vazar para a suíte: testes que criam repositórios temporários
# passariam a operar no gitdir do Farol e falhariam como "not a work tree".
# O próprio Git mantém a lista autoritativa; não repetimos nomes à mão.
unset $(git rev-parse --local-env-vars)

echo "  -> sintaxe (npm run check)"
npm run check --silent || falhou "a sintaxe"

echo "  -> qualidade e higiene (npm run lint)"
npm run lint --silent || falhou "o gate de qualidade"

echo "  -> suite (npm test)"
npm test --silent || falhou "a suite"

# --- constituicao (npm run eng) ------------------------------------------------
# Fica AQUI e nao no `npm run lint`, que roda no CI. O porque tem um endereco so,
# em docs/QUALITY.md, secao "A constituicao vem do eng-behaviour". O que importa
# para este hook: como ele tambem proibe push direto na main, todo caminho ate a
# main atravessa este gate.
echo "  -> constituicao (npm run eng)"
npm run eng --silent || falhou "o gate do eng-behaviour"

echo ""
echo "  ok  gate local verde. Lembrando que a matriz Linux/Windows/macOS so fecha no CI."
echo ""
