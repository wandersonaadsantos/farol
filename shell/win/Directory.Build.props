<Project>
  <!-- Padrões comuns a todos os projetos da casca Windows. -->
  <PropertyGroup>
    <!-- C# 12, a linguagem do SDK do .NET 8: fixa para o código não depender da máquina. -->
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
