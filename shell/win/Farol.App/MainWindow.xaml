<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Farol.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Farol.App"
    Title="Farol">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título própria: a área de arrastar, com as cores que o motor manda. -->
        <Grid x:Name="DragRegion" Grid.Row="0">
            <TextBlock
                x:Name="TitleText"
                Text="Farol"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Aqui entra o WebView2, criado só quando o runtime existe, ou o aviso de runtime ausente. -->
        <Border x:Name="ContentHost" Grid.Row="1" />
    </Grid>
</Window>
