<Project Sdk="Microsoft.NET.Sdk">

  <!-- A casca Windows: WinUI 3 empacotada em MSIX. Só compila no Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Farol.App</RootNamespace>
    <AssemblyName>Farol</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- Runtime do Windows App SDK dentro do pacote: o App Installer instala numa maquina limpa sem um segundo asset.
         Plano B, se o publish empacotado self-contained falhar no Windows real: publicar Dependencies\x64\Microsoft.WindowsAppRuntime.1.6.msix na release e declarar <Dependencies> no appinstaller. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <!-- Ícone da bandeja, lido do disco pelo LoadImageW; copiado de assets/farol.ico da raiz. -->
    <Content Include="Assets\farol.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- O motor embutido (engine\app\server.js e engine\node\node.exe), encenado aqui pelo
       tools\release\montar-win.ps1 antes do publish e fora do git; entra no MSIX em engine\... -->
  <ItemGroup>
    <Content Include="engine\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Farol.Contrato\Farol.Contrato.csproj" />
    <ProjectReference Include="..\Farol.Sidecar\Farol.Sidecar.csproj" />
  </ItemGroup>

  <!-- Habilita o empacotamento MSIX pelo Visual Studio e pela linha de comando, como no modelo do Windows App SDK. -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

</Project>
